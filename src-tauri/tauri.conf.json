{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bambuddy Monitor",
  "version": "0.2.0",
  "identifier": "io.github.bambuddy-monitor",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Live camera and status when a Bambuddy print starts",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
